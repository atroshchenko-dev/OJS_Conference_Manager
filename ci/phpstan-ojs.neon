# Analysis of the OJS-facing layers against a real OJS 3.5 tree.
# Usage: OJS_ROOT=/path/to/ojs php phpstan.phar analyse -c ci/phpstan-ojs.neon
parameters:
    level: 5
    paths:
        - ../ConferenceManagerPlugin.php
        - ../classes
    bootstrapFiles:
        - phpstan-ojs-bootstrap.php
    scanDirectories:
        - %env.OJS_ROOT%/classes
        - %env.OJS_ROOT%/lib/pkp/classes
    excludePaths:
        analyseAndScan:
            - ../vendor
    ignoreErrors:
        # Eloquent query scopes of PKP models (scopeWithSubmissionIds…) are resolved by __callStatic.
        - '#^Call to an undefined static method PKP\\stageAssignment\\StageAssignment::with[A-Za-z]+\(\)\.$#'
