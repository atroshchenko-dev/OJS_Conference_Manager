msgstr "Форма участі"

msgid "plugins.generic.conferenceManager.registration.presenterEmail"
msgstr "Хто доповідає"

msgid "plugins.generic.conferenceManager.registration.presenterEmail.description"
msgstr "Електронна пошта доповідача так, як вона вказана у списку авторів подання."

msgid "plugins.generic.conferenceManager.registration.consent"
msgstr "Згода на обробку персональних даних"

msgid "plugins.generic.conferenceManager.registration.consent.agree"
msgstr "Я погоджуюся з умовами обробки персональних даних"

msgid "plugins.generic.conferenceManager.registration.consent.given"
msgstr "Надано"

msgid "plugins.generic.conferenceManager.registration.consent.missing"
msgstr "Не надано"

msgid "plugins.generic.conferenceManager.registration.consent.default"
msgstr "Я погоджуюся, що організатор заходу обробляє мої персональні дані (ім'я, електронну пошту, заклад, країну) для участі в заході, публікації матеріалів і видачі сертифіката. Дані зберігаються, доки це потрібно для цих цілей, і не передаються іншим особам, крім випадків, передбачених законом."

