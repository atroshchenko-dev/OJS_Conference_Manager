msgstr "підтверджено"

msgid "plugins.generic.conferenceManager.registration.confirmationStatus.declined"
msgstr "відмовився"

msgid "plugins.generic.conferenceManager.registration.error.editionRequired"
msgstr "Оберіть захід, на який подається матеріал."

msgid "plugins.generic.conferenceManager.registration.error.callClosed"
msgstr "Прийом матеріалів на цей захід закрито."

msgid "plugins.generic.conferenceManager.registration.error.required"
msgstr "Це поле обов'язкове."

msgid "plugins.generic.conferenceManager.registration.error.presenterNotAuthor"
msgstr "Доповідач має бути одним з авторів подання: перевірте електронну пошту в списку авторів."

msgid "plugins.generic.conferenceManager.registration.error.consentRequired"
msgstr "Без згоди на обробку персональних даних подання не можна завершити."

msgid "plugins.generic.conferenceManager.registration.error.consentOutdated"
msgstr "Текст згоди змінився. Перегляньте його й погодьтеся ще раз."

msgid "plugins.generic.conferenceManager.registration.error.alreadySubmitted"
msgstr "Анкету вже не можна змінити: подання надіслано."

msgid "plugins.generic.conferenceManager.registration.mail.confirmSubject"
msgstr "Підтвердьте участь: {$edition}"

msgid "plugins.generic.conferenceManager.registration.mail.confirmBody"
msgstr "<p>Шановна(-ий) {$name}!</p><p>{$submitter} подав(-ла) матеріал «{$submission}» на захід «{$edition}» і вказав(-ла) вас як автора. Ваша роль: {$role}.</p><p>Підтвердьте, будь ласка, участь або відмовтеся за посиланням (обліковий запис не потрібен):<br><a href=\"{$url}\">{$url}</a></p><p>Посилання діє до {$expires} і спрацьовує один раз.</p><p>Якщо ви не маєте стосунку до цього подання, просто проігноруйте лист.</p><p>{$journal}</p>"

msgid "plugins.generic.conferenceManager.confirm.title"
msgstr "Підтвердження участі"

msgid "plugins.generic.conferenceManager.confirm.question"
msgstr "Вас ({$email}) указано автором матеріалу, поданого на цей захід. Підтвердьте участь або відмовтеся."

msgid "plugins.generic.conferenceManager.confirm.accept"
msgstr "Підтверджую участь"

msgid "plugins.generic.conferenceManager.confirm.decline"
msgstr "Відмовляюся"

msgid "plugins.generic.conferenceManager.confirm.done.confirmed"
msgstr "Дякуємо! Участь підтверджено."

msgid "plugins.generic.conferenceManager.confirm.done.declined"
msgstr "Відповідь записано: ви відмовилися від участі."

msgid "plugins.generic.conferenceManager.confirm.expired"
msgstr "Термін дії посилання минув. Зверніться до організаторів заходу."

msgid "plugins.generic.conferenceManager.confirm.invalid"
msgstr "Посилання недійсне або вже використане."

msgid "plugins.generic.conferenceManager.institution.section.submissions"
msgstr "Подання"

msgid "plugins.generic.conferenceManager.institution.allowRegularSubmissions"
msgstr "Журнал приймає й звичайні статті, не пов'язані з конференціями"

msgid "plugins.generic.conferenceManager.institution.allowRegularSubmissions.description"
msgstr "Якщо ввімкнено, автор може в майстрі подання обрати «Не для конференції». Якщо вимкнено, поки відкрито прийом на будь-який захід, кожне подання має бути на якийсь захід."

msgid "plugins.generic.conferenceManager.validation.pathReserved"
msgstr "Ця адреса зарезервована для сторінок плагіна. Оберіть іншу."

msgid "plugins.generic.conferenceManager.confirm.retry"
msgstr "Не вдалося перевірити форму. Натисніть кнопку ще раз."
