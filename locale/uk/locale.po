msgid "plugins.generic.conferenceManager.registration.edition.descriptionOptional"
msgstr "Показано заходи, на які зараз приймаються матеріали. Якщо це звичайна стаття, залиште «Не для конференції»."

msgid "plugins.generic.conferenceManager.registration.edition.deadline"
msgstr "прийом до {$date}"

msgid "plugins.generic.conferenceManager.registration.presentationType"
msgstr "Бажаний тип доповіді"

