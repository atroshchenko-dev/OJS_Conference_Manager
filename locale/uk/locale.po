msgid "plugins.generic.conferenceManager.displayName"
msgstr "Менеджер конференцій"

msgid "plugins.generic.conferenceManager.description"
msgstr "Конференції, школи, семінари й інші наукові та освітні заходи на базі OJS 3.5 для будь-якого закладу-організатора: реєстрація, оргвнески, програма, сертифікати, збірники."

msgid "plugins.generic.conferenceManager.institution.title"
msgstr "Профіль закладу-організатора"

msgid "plugins.generic.conferenceManager.institution.intro"
msgstr "Ці дані використовуються в рахунках, сертифікатах і на публічних сторінках заходів цього контексту. Кожен контекст має власний профіль, тому одна інсталяція OJS може обслуговувати кілька закладів."

msgid "plugins.generic.conferenceManager.institution.section.main"
msgstr "Заклад"

msgid "plugins.generic.conferenceManager.institution.section.privacy"
msgstr "Персональні дані"

msgid "plugins.generic.conferenceManager.institution.section.importExport"
msgstr "Імпорт і експорт профілю"

msgid "plugins.generic.conferenceManager.institution.jurisdiction.description"
msgstr "Профіль юрисдикції вмикає національні поля й документи. «Україна» додає ЄДРПОУ, казначейські рахунки, сертифікати підвищення кваліфікації та експорт для «Вектора». Після зміни збережіть форму й відкрийте її знову, щоб побачити поля нового профілю."

msgid "plugins.generic.conferenceManager.institution.privacyNotice.description"
msgstr "Повідомлення про обробку персональних даних, яке бачать учасники під час реєстрації."

msgid "plugins.generic.conferenceManager.institution.export"
msgstr "Завантажити профіль у форматі JSON"

msgid "plugins.generic.conferenceManager.institution.import"
msgstr "Імпорт профілю (JSON)"

msgid "plugins.generic.conferenceManager.institution.import.description"
msgstr "Вставте JSON, експортований з іншого контексту, і збережіть форму. Підписанти й рахунки з файлу замінять поточні; логотип і печатка не змінюються. Інші поля форми при імпорті ігноруються."

