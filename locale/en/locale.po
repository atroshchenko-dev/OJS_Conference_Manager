msgid "plugins.generic.conferenceManager.displayName"
msgstr "Conference Manager"

msgid "plugins.generic.conferenceManager.description"
msgstr "Conferences, schools, seminars and other scholarly and educational events on top of OJS 3.5 for any organizing institution: registration, fees, programme, certificates, proceedings."

msgid "plugins.generic.conferenceManager.institution.title"
msgstr "Organizing institution profile"

msgid "plugins.generic.conferenceManager.institution.intro"
msgstr "These details are used in invoices, certificates and public event pages of this context. Every context has its own profile, so one OJS installation can serve several institutions."

