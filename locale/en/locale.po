msgid "plugins.generic.conferenceManager.institution.jurisdiction.description"
msgstr "The jurisdiction profile switches national fields and documents on. \"Ukraine\" adds the EDRPOU code, treasury accounts, professional development certificates and export for the Vector platform. After changing it, save the form and open it again to see the fields of the new profile."

msgid "plugins.generic.conferenceManager.institution.privacyNotice.description"
msgstr "Privacy notice participants see when they register."

